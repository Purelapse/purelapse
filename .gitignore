# Python
__pycache__/
*.pyc
.venv/

# Bauergebnisse
build/
dist/
*.AppImage

# Abgelegte alte Staende - gehoeren nicht ins Repository
archiv/

# Protokolle und Messdaten, die Purelapse im Bilderordner anlegt
purelapse_*.csv
purelapse_*.log

# Begleitdateien von Bildern (Bewertungen, Darktable-Verlauf) - enthalten
# u. a. den Namen des Fotografen und gehoeren nicht ins Repository
*.xmp
*.XMP
# ... ausser den bereinigten Beispielen der Pruefungen (ohne Name/E-Mail)
!tests/daten/*.xmp

# Arbeitsdateien der Pruefungen
purelapse_pruefung/

# Bildschirmfotos zum Hochladen in Releases (liegen im Release, nicht im Code)
*_screenshot.jpg
/*.mp4

# Bilder und Videos, die beim Arbeiten im Projektordner landen koennen
# (Rohdaten, Exporte, Testvideos). Die Webseite (docs/) ist davon ausgenommen.
/*.jpg
/*.jpeg
/*.png
/*.tif
/*.tiff
/*.mov
/*.mkv
*.NEF
*.nef
*.CR2
*.CR3
*.ARW
*.DNG
*.RAF
*.ORF
*.RW2
*.exe
